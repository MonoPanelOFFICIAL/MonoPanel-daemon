# MonoPanel daemon configuration.
# Easiest way to fill this in: from the panel, Admin > Nodes > Add node (or Admin > VPS Nodes > Add node), then run
# the one-line command it shows:  npm run configure -- --panel https://your-panel --key <SECRET>
# One daemon serves both game/app servers and VPSes. If you register the same address in both places the panel
# reuses one secret for both.

# Shared secret generated by the panel when you add the node (>= 32 chars). REQUIRED.
DAEMON_SECRET=

# ---------------------------------------------------------------- database (PostgreSQL, required)
# The daemon stores its state (server definitions, installer progress, recycle-bin index) in PostgreSQL.
# There is no SQLite or JSON-file mode. Use ONE database (or one DATABASE_TABLE_PREFIX) per node, e.g.:
#   CREATE USER daemon WITH PASSWORD 'change-me';
#   CREATE DATABASE monopanel_daemon OWNER daemon;
# Tables are created automatically on first start. Only one daemon process may use a database.
DATABASE_URL=postgres://daemon:change-me@127.0.0.1:5432/monopanel_daemon
# disable | require | verify | no-verify   (empty: whatever ?sslmode= in DATABASE_URL says)
DATABASE_SSL=
# Path to your provider's CA certificate (only if it is not publicly trusted)
DATABASE_SSL_CA=
DATABASE_POOL_MAX=3
DATABASE_TABLE_PREFIX=daemon_

# Network
DAEMON_HOST=0.0.0.0
DAEMON_PORT=3002
# Comma-separated panel IPs allowed to talk to the daemon. Strongly recommended.
ALLOWED_IPS=
# Optional TLS (recommended when the panel and node are on different networks)
TLS_CERT=
TLS_KEY=

# ---------------------------------------------------------------- what this node hosts
# One daemon serves every kind of hosting. List the kinds THIS node should accept (comma-separated). Default: all of them.
#   bot       generic bot / app servers          nodejs    dedicated Node.js hosting
#   website   full-stack websites (domains)      lavalink  Lavalink audio nodes          vps   customer VPSes (needs Docker)
# The panel only sells the kinds its owner enabled; this makes a node refuse the others too (e.g. a Lavalink-only node).
NODE_SERVICES=bot,nodejs,website,lavalink,vps

# ---------------------------------------------------------------- website hosting (built-in reverse proxy)
# 0 = off. When off, point your own front proxy (Caddy, nginx, Cloudflare Tunnel) at each site's port instead.
# Ports below 1024 need root or:  setcap cap_net_bind_service=+ep $(which node)
WEB_HTTP_PORT=0
WEB_HTTPS_PORT=0
WEB_HOST=0.0.0.0
# HTTPS: folder holding <domain>/fullchain.pem and <domain>/privkey.pem (certbot's /etc/letsencrypt/live works as is).
# A folder called _wildcard.<parent domain> serves every subdomain of that parent.
WEB_CERT_DIR=
# certbot webroot challenges are served from here:  certbot certonly --webroot -w <WEB_ACME_DIR> -d example.com
WEB_ACME_DIR=./data/acme
WEB_FORCE_HTTPS=true
# Only when another proxy (Cloudflare, nginx) sits in front: its IP(s), so X-Forwarded-For is believed. Empty = never.
WEB_TRUST_PROXY=

# ---------------------------------------------------------------- servers (games, bots, apps)
# Runtime: auto | docker | podman | process
#   auto    -> docker socket if reachable, else podman socket, else native process sandbox
#   process -> no container engine needed (works on OpenVZ/LXC/Termux/tiny VPS)
RUNTIME=auto
# Docker/Podman API socket (Podman: /run/podman/podman.sock or $XDG_RUNTIME_DIR/podman/podman.sock)
CONTAINER_SOCKET=/var/run/docker.sock
# Optional OCI runtime for stronger sandboxing: runsc (gVisor), kata, sysbox-runc ...
OCI_RUNTIME=
# Process runtime sandbox: auto | bwrap | none
PROCESS_SANDBOX=auto

# Storage
DATA_DIR=./data
VOLUMES_DIR=./data/volumes
BACKUPS_DIR=./data/backups

# Host port range servers may bind (the panel allocates inside this range)
PORT_MIN=20000
PORT_MAX=40000

# Container user (files in volumes are chowned to this when the daemon runs as root)
CONTAINER_UID=1000
CONTAINER_GID=1000

# Only pull images whose name starts with one of these (comma-separated). Empty = any.
ALLOWED_IMAGE_PREFIXES=
# Allow installer file downloads from private networks (default false: blocks SSRF)
ALLOW_PRIVATE_DOWNLOADS=false

# --- SFTP (optional; needs the optional `ssh2` package, installed automatically by npm install) ---
# 0 disables SFTP. Open this port to customers, e.g. 2022. Users log in as <panel-username>.<server-id8> with an
# SFTP password generated from their server's Settings tab. Each login is confined to that one server's files.
SFTP_PORT=0
SFTP_HOST_KEY=

# Largest server (compressed) accepted when another node sends us a server (node switching), in MB
MAX_TRANSFER_MB=20480

# ---------------------------------------------------------------- VPS hosting (customer VPSes as Docker containers)
# auto   -> enabled when the `docker` CLI works, otherwise VPS hosting stays off and the node only runs servers
# docker -> enabled, and the daemon refuses to start if Docker does not answer
# mock   -> fake in-memory VPSes for development without Docker (never use in production)
# off    -> never host VPSes on this node
VPS_RUNTIME=auto
# Optional OCI runtime for VPS isolation (e.g. sysbox-runc, runsc). Needed for Docker inside a VPS unless VPS_PRIVILEGED=true.
VPS_OCI_RUNTIME=
# Docker inside a VPS needs ONE of: VPS_OCI_RUNTIME=sysbox-runc (recommended, secure) or VPS_PRIVILEGED=true (insecure: VPS root can escape to the host).
VPS_PRIVILEGED=false
# Base images the panel may ask for (comma-separated prefixes). Debian/Ubuntu family only (apt is used to install sshd).
VPS_ALLOWED_BASE_PREFIXES=ubuntu:,debian:
# OS ids to build the VPS image for at daemon start, so the first customer does not wait several minutes (comma-separated, e.g. ubuntu-22.04,debian-12)
VPS_PREBUILD_OS=ubuntu-22.04
